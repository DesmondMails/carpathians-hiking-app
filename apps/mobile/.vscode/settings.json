{
  "editor.formatOnSave": true,

  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": true
  },

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  "eslint.useFlatConfig": true,
  "eslint.experimental.useFlatConfig": true
}
