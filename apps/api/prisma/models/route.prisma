model Route {
  id                   String      @id @default(uuid())
  draftId              String?     @unique
  draft                RouteDraft? @relation(fields: [draftId], references: [id])
  title                String
  description          String?
  region               String?
  difficulty           Difficulty?
  routeType            RouteType?
  distanceM            Float?
  elevationGainM       Int?
  durationH            Float?
  coverImageId         String?
  images               RouteImage[]
  notes                String?
  routeCoordinatesJson Json?
  elevationProfileJson Json?
  poiMarkersJson       Json?
  gpxStorageKey        String?
  gpxAvailable         Boolean     @default(false)
  rating               Float       @default(0)
  reviewCount          Int         @default(0)
  status               RouteStatus @default(DRAFT)
  createdByUserId      String
  createdByUser        User        @relation(fields: [createdByUserId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([createdByUserId])
  @@index([status])
}

enum RouteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MODERATE
  HARD
  EXTREME
}

enum RouteType {
  LOOP
  OUT_AND_BACK
  POINT_TO_POINT
}
